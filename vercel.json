{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "routes/**/*",
        "controllers/**/*",
        "models/**/*",
        "middleware/**/*",
        "services/**/*",
        "utils/**/*",
        "config/**/*",
        "public/**/*",
        "uploads/**/*"
      ],
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
